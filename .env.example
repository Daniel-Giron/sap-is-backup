# Example environment file for SAP Integration Suite backup
# Copy this to .env and fill in your credentials

SAP_HOST="https://<tenant>.integration.sap.com/api"
SAP_USER="your-username"
SAP_PASSWORD="your-password"

# Comma-separated list of backup tags to apply (default: "latest")
# "latest" is always moved to the newest backup
# Other tags (e.g. "weekly", "monthly") are created only once
BACKUP_TAGS="latest"